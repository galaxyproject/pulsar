<job_conf>
    <plugins workers="4">
      <plugin id="local" type="runner" load="galaxy.jobs.runners.local:LocalJobRunner"/>
      <plugin id="pulsar_rest" type="runner" load="galaxy.jobs.runners.pulsar:PulsarRESTJobRunner">
      </plugin>
    </plugins>
    <!-- Handle jobs in the web process. A separate handler races with the web
         worker to initialize Planemo's fresh SQLite database. -->
    <destinations default="pulsar_rest">
      <destination id="local" runner="local"/>
      <destination id="pulsar_rest" runner="pulsar_rest">
        <param id="url">http://localhost:8913/</param>
        <param id="docker_enabled">true</param>
        <param id="docker_sudo">false</param>
        <param id="outputs_to_working_directory">false</param>
      </destination>
    </destinations>
    <tools>
      <tool id="__DATA_FETCH__" destination="local" />
    </tools>
</job_conf>
